{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/git",
      {
        "assets": [
          "@Resources/scripts/Script.lua",
          "@Resources/variables.inc",
          "@Resources/version.inc",
          "@Resources/words.txt",
          "4000 English Words/4000 English Words.ini",
          "4000 English Words/4000 English Words Compact.ini",
          "4000 English Words/4000 English Words Wrapped.ini",
          "README.md",
          "CHANGELOG.md",
          "package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ],
  "tagFormat": "v${version}"
}
